[sub_resource type="GDScript" id="GDScript_n0yra"]
resource_name = "dialogue_system"
script/source = "extends Node2D
const DialogueButtonPreLoad = preload(\"res://scence/dialogue_button.tscn\")

@onready var DialogueLabel: RichTextLabel = $Panel/HBoxContainer/VBoxContainer/RichTextLabel
@onready var SpeakerSprite: Sprite2D = $Panel/HBoxContainer/SpeakerParent/Sprite2D

var dialogue: Array[DE]
var current_dialogue_item: int = 0
var next_item: bool = true

var player_node: CharacterBody2D
func _ready() -> void:
	visible = false
	top_level = true  
	$Panel/HBoxContainer/VBoxContainer/button_container.visible = false
	
	for i in get_tree().get_nodes_in_group(\"player\"):
		player_node = i

func _process(_delta: float) -> void:
	if current_dialogue_item == dialogue.size():
		if !player_node:
			for i in get_tree().get_nodes_in_group(\"player\"):
				player_node = i
			return
		player_node.can_move = true
		queue_free()
		return
	
	if next_item:
		next_item = false
		var i = dialogue[current_dialogue_item]
		
		if i is DialogueFunction:
			if i.hide_dialogue_box:
				visible = false
			else:
				visible = true
			_function_resource(i)
		elif i is DialogueChoice:
			visible = true
			_choice_resource(i)
			
		elif i is DialogueText:
			visible = true
			_text_resource(i)
		elif i is DialogueText:
			print(\">> showing DialogueText index \", current_dialogue_item)
			visible = true
			_text_resource(i)
		else:
			printerr(\"You accidentally added a DE resource!\")
			current_dialogue_item += 1
			next_item = true
	
func _function_resource(i: DialogueFunction) -> void:
	print(\"_function_resource called! path: \", i.target_path, \" function: \", i.function_name)
	var target_node = _get_node_from_path(i.target_path)
	if not target_node:
	# try absolute path from root
		target_node = get_tree().root.get_node_or_null(i.target_path)
	if not target_node:
		print(\"Could not find node at path: \", i.target_path)
		current_dialogue_item += 1
		next_item = true
		return
	if target_node.has_method(i.function_name):
		if i.function_arguments.size() == 0:
			target_node.call(i.function_name)
		else:
			target_node.callv(i.function_name, i.function_arguments)
	if i.wait_for_signal_to_continue:
		var signal_name = i.wait_for_signal_to_continue
		if target_node.has_signal(signal_name):
			var signal_state = { \"done\": false }
			var callable = func(_args): signal_state.done = true
			target_node.connect(signal_name, callable, CONNECT_ONE_SHOT)
			while not signal_state.done:
				await get_tree().process_frame
	current_dialogue_item += 1
	next_item = true

func _choice_resource(i: DialogueChoice) -> void:
	DialogueLabel.text = i.text
	DialogueLabel.visible_characters = -1
	if i.speaker_img:
		$Panel/HBoxContainer/SpeakerParent.visible = true
		SpeakerSprite.texture = i.speaker_img
		SpeakerSprite.hframes = i.speaker_img_Hframes
		SpeakerSprite.frame = min(i.speaker_img_select_frame, i.speaker_img_Hframes - 1)
	else:
		$Panel/HBoxContainer/SpeakerParent.visible = false

	$Panel/HBoxContainer/VBoxContainer/button_container.visible = true

	var any_out_of_stock = false

	for item in i.choice_text.size():
		var choice_name = i.choice_text[item].to_lower().strip_edges()

		if QuestManager.shop_stock.has(choice_name) and QuestManager.shop_stock[choice_name] <= 0:
			any_out_of_stock = true
			continue

		var DialogueButtonVar = DialogueButtonPreLoad.instantiate()
		DialogueButtonVar.text = i.choice_text[item]
		var function_resource: DialogueFunction = i.choice_function_call[item]
		DialogueButtonVar.connect(\"pressed\",
			_on_choice_pressed.bind(function_resource),
			CONNECT_ONE_SHOT)

		$Panel/HBoxContainer/VBoxContainer/button_container.add_child(DialogueButtonVar)

	if any_out_of_stock:
		DialogueLabel.text += \"\\n\\n(Some items are out of stock — try the farmer!)\"
		DialogueLabel.visible_characters = -1

	var buttons = $Panel/HBoxContainer/VBoxContainer/button_container.get_children()
	if buttons.size() > 0:
		while Input.is_action_pressed(\"ui_accept\"):
			await get_tree().process_frame
		await get_tree().process_frame
		buttons[0].grab_focus()

func _choice_button_pressed(target_node: Node, wait_for_signal_to_continue: String) -> void:
	$Panel/HBoxContainer/VBoxContainer/button_container.visible = false
	for i in $Panel/HBoxContainer/VBoxContainer/button_container.get_children():
		i.queue_free()

	if wait_for_signal_to_continue:
		var signal_name = wait_for_signal_to_continue
		if target_node.has_signal(signal_name):
			var signal_state = { \"done\": false }
			var callable = func(_args): signal_state.done = true
			target_node.connect(signal_name, callable, CONNECT_ONE_SHOT)
			while not signal_state.done:
				await get_tree().process_frame

	current_dialogue_item += 1
	next_item = true

func _on_choice_pressed(function_resource: DialogueFunction) -> void:
	var target_node: Node = null
	var wait_signal: String = \"\"

	if function_resource:
		print(\"choice pressed → calling: \", function_resource.function_name, \" on \", function_resource.target_path)
		target_node = _get_node_from_path(function_resource.target_path)
		wait_signal = function_resource.wait_for_signal_to_continue

		if target_node and target_node.has_method(function_resource.function_name):
			if function_resource.function_arguments.size() == 0:
				target_node.call(function_resource.function_name)
			else:
				target_node.callv(function_resource.function_name, function_resource.function_arguments)
		else:
			print(\"FAILED: could not call \", function_resource.function_name, \" on \", function_resource.target_path)

		if function_resource.hide_dialogue_box:
			hide()
	else:
		print(\"choice pressed → no function attached\")

	_choice_button_pressed(target_node, wait_signal)

func _text_resource(i: DialogueText) -> void:
	$AudioStreamPlayer.stream = i.text_sound
	$AudioStreamPlayer.volume_db = i.text_volume_db
	var camera: Camera2D = get_viewport().get_camera_2d()
	if camera and i.camera_position != Vector2(999.999, 999.999):
		var camera_tween: Tween = create_tween().set_trans(Tween.TRANS_SINE)
		camera_tween.tween_property(camera, \"global_position\", i.camera_position, i.camera_transition_time)
	if !i.speaker_img:
		$Panel/HBoxContainer/SpeakerParent.visible = false
	else:
		$Panel/HBoxContainer/SpeakerParent.visible = true
		SpeakerSprite.texture = i.speaker_img
		SpeakerSprite.hframes = i.speaker_img_Hframes
		SpeakerSprite.frame = 0
		await get_tree().process_frame

		# Then scale
		var parent_size = $Panel/HBoxContainer/SpeakerParent.size
		var sprite_size = Vector2(i.speaker_img.get_width() / i.speaker_img_Hframes, i.speaker_img.get_height())
		var scale_factor = min(parent_size.x / sprite_size.x, parent_size.y / sprite_size.y)
		SpeakerSprite.scale = Vector2(scale_factor, scale_factor)
		SpeakerSprite.position = parent_size / 2
	
	DialogueLabel.visible_characters = 0
	DialogueLabel.text = i.text
	var text_without_square_brackets: String = _text_without_square_brackets(i.text)
	var total_characters: int = text_without_square_brackets.length()
	var character_timer: float = 0.0
	while DialogueLabel.visible_characters < total_characters:
		if Input.is_action_just_pressed(\"ui_cancel\"):
			DialogueLabel.visible_characters = total_characters
			break
			
		character_timer += get_process_delta_time()
		if character_timer >= (1.0 / i.text_speed) or text_without_square_brackets[DialogueLabel.visible_characters] == \" \":
			var character: String = text_without_square_brackets[DialogueLabel.visible_characters]
			DialogueLabel.visible_characters += 1
			
			if character != \" \":
				$AudioStreamPlayer.pitch_scale = randf_range(i.text_volume_pitch_min, i.text_volume_pitch_max)
				$AudioStreamPlayer.play()
				

				if i.speaker_img_Hframes != 1:
					if SpeakerSprite.frame < i.speaker_img_Hframes - 1:
						SpeakerSprite.frame += 1
					else:
						SpeakerSprite.frame = 0
			
			character_timer = 0.0
		await get_tree().process_frame
	SpeakerSprite.frame = min(i.speaker_img_rest_frame, i.speaker_img_Hframes-1)
	
	while true:
		await get_tree().process_frame
		if DialogueLabel.visible_characters == total_characters:
			if Input.is_action_just_pressed(\"ui_accept\"):
				get_viewport().set_input_as_handled()
				current_dialogue_item += 1
				next_item = true
				return

func _get_node_from_path(path: String) -> Node:
	var node = get_node_or_null(path)
	if node:
		print(\"found via get_node: \", path)
		return node
	node = get_tree().root.get_node_or_null(path)
	if node:
		print(\"found via root: \", path)
		return node
	var nodes = get_tree().get_nodes_in_group(path)
	print(\"group search for '\", path, \"' found: \", nodes.size(), \" nodes\")
	if nodes.size() > 0:
		return nodes[0]
	return null


func _text_without_square_brackets(text: String) -> String:
	var result: String = \"\"
	var inside_bracket: bool = false
	
	for i in text:
		if i == \"[\":
			inside_bracket = true
			continue
			
		if i == \"]\":
			inside_bracket = false
			continue
			
		if !inside_bracket:
			result += i
			
	return result
"

