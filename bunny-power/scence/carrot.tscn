[sub_resource type="GDScript" id="GDScript_307tc"]
resource_name = "ingredient_pickup.gd"
script/source = "extends Area2D

@export var ingredient_name: String = \"carrot\"
var player_nearby = false

func _ready():
	$Label.visible = false
	$AnimatedSprite2D.play(\"IDLE\")  # plays your animation on spawn

func _on_body_entered(body):
	if body.is_in_group(\"player\"):
		player_nearby = true
		$Label.visible = true

func _on_body_exited(body):
	if body.is_in_group(\"player\"):
		player_nearby = false
		$Label.visible = false

func _input(event):
	if event.is_action_pressed(\"ui_accept\") and player_nearby:
		QuestManager.collect_ingredient(ingredient_name)
		queue_free()
"

