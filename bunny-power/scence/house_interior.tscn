[sub_resource type="GDScript" id="GDScript_wigdr"]
script/source = "# house_interior.gd
extends Node2D

func _ready():
	var player = get_tree().get_first_node_in_group(\"player\")
	if not player:
		return
	if QuestManager.came_from_kitchen:
		var spawn = $StoveSpawn
		if spawn:
			player.global_position = spawn.global_position
		QuestManager.came_from_kitchen = false
	else:
		var spawn = $SpawnPoint
		if spawn:
			player.global_position = spawn.global_position

func _on_stove_area_body_entered(body: Node2D) -> void:
	pass

func _on_stove_area_body_exited(body: Node2D) -> void:
	pass
"

