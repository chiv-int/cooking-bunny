[sub_resource type="GDScript" id="GDScript_14qux"]
resource_name = "world"
script/source = "
extends Node2D

func _ready():
	print(\"came_from_house value is: \", QuestManager.came_from_house)
	if QuestManager.came_from_house:
		var player = get_tree().get_first_node_in_group(\"player\")
		var spawn = $SpawnPoint
		if player and spawn:
			player.global_position = spawn.global_position
		QuestManager.came_from_house = false 
"

