[sub_resource type="GDScript" id="GDScript_yiujq"]
resource_name = "trivia_box.gd"
script/source = "extends Control

signal answer_correct
signal answer_wrong

@onready var question_label: Label = $VBoxContainer/QuestionLable
@onready var button_container: VBoxContainer = $VBoxContainer/ButtonContainer

var correct_index: int = -1

func _ready() -> void:
	visible = false

func open_trivia(question_text: String, answers: Array, correct: int) -> void:
	visible = true
	question_label.text = question_text
	correct_index = correct

	# clear any old buttons
	for child in button_container.get_children():
		child.queue_free()

	# build a button per answer
	for i in answers.size():
		var btn = Button.new()
		btn.text = answers[i]
		btn.pressed.connect(_on_answer_pressed.bind(i))
		button_container.add_child(btn)

	# focus the first button so keyboard/controller can navigate
	await get_tree().process_frame
	if button_container.get_child_count() > 0:
		button_container.get_child(0).grab_focus()

	print(\"trivia opened: \", question_text)

func close_trivia() -> void:
	visible = false
	for child in button_container.get_children():
		child.queue_free()

func _on_answer_pressed(index: int) -> void:
	print(\"answer pressed: \", index, \" | correct is: \", correct_index)
	if index == correct_index:
		emit_signal(\"answer_correct\")
	else:
		emit_signal(\"answer_wrong\")
"

